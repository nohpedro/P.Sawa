*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.cache/

# Virtual environments
.venv/
venv/
ENV/
env/
.virtualenv/

# =========================
# Django
# =========================
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Django migrations (NO ignorar por defecto; importante versionarlas)
# */migrations/*.py
# !*/migrations/__init__.py

# Static / Media
staticfiles/
static/
media/

# Translations
*.mo

# =========================
# Environment / Secrets
# =========================
.env
.env.*
compose/*.env
!compose/example.env

# Certificates / keys
*.pem
*.key
*.crt
*.p12

# =========================
# Docker
# =========================
# Build artifacts
docker/**/__pycache__/
docker/**/.pytest_cache/

# Volúmenes locales (si usas carpeta para persistencia)
pgdata/
postgres-data/
data/

# Docker override files
docker-compose.override.yml

# =========================
# IDEs / Editors
# =========================
.vscode/
.idea/
*.iml

# =========================
