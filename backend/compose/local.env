# === Django local (Python + PostgreSQL + Node) ===
DJANGO_SETTINGS_MODULE=core.settings.dev
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-secret-key-change-me
ALLOWED_HOSTS=*

# Base de datos local
POSTGRES_DB=proy_volley
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cambia a 1 solo si quieres usar SQLite local en vez de PostgreSQL.
USE_SQLITE=0

# Zona horaria local/app
TZ=America/Santiago
