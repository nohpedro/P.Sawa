# === Django local cliente (Python + SQLite + Node) ===
DJANGO_SETTINGS_MODULE=core.settings.dev
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-secret-key-change-me
ALLOWED_HOSTS=*

# Base de datos PostgreSQL local.
# Estos datos solo se usan si USE_SQLITE=0.
POSTGRES_DB=proy_volley
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Para instalacion simple en una sola PC usa SQLite.
# No requiere instalar ni iniciar PostgreSQL.
USE_SQLITE=1

# Zona horaria local/app
TZ=America/Santiago
