# === Django (PROD) ===
DJANGO_SETTINGS_MODULE=core.settings.prod
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=${DJANGO_SECRET_KEY:?set-in-deployment}
ALLOWED_HOSTS=proy-volley.example.com

# Base de datos (usa secretos/vars del orquestador en producción)
POSTGRES_DB=proy_volley
POSTGRES_USER=${POSTGRES_USER:?set-in-deployment}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:?set-in-deployment}
POSTGRES_HOST=db
POSTGRES_PORT=5432

TZ=UTC
